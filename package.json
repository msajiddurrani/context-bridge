{
  "name": "context-bridge",
  "displayName": "Context Bridge",
  "version": "0.0.1",
  "description": "Cross-platform AI context synchronization layer for software engineers",
  "author": "Context Bridge",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.11.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/jsdom": "^30.0.0",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.17",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.33",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "5.3.3",
    "vitest": "^5.0.5"
  },
  "manifest": {
    "host_permissions": [
      "https://claude.ai/*",
      "https://chatgpt.com/*",
      "https://*.chatgpt.com/*",
      "https://gemini.google.com/*",
      "https://perplexity.ai/*",
      "https://*.perplexity.ai/*",
      "https://chat.deepseek.com/*",
      "https://grok.com/*",
      "https://generativelanguage.googleapis.com/*",
      "https://api.openai.com/*"
    ],
    "permissions": [
      "storage",
      "activeTab"
    ]
  }
}
